<!DOCTYPE html>
<html lang="fr">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Aurores — Tromsø / Grindavík</title>
<link rel="icon" href="favicon.ico" sizes="any">
<link rel="icon" type="image/png" sizes="32x32" href="favicon-32.png">
<link rel="apple-touch-icon" href="apple-touch-icon.png">
<style>
  :root{
    --blue:#0066cc; --blue-dark:#003366; --blue-soft:#e6f0ff;
    --border:#d9e2ef; --text:#333; --muted:#666;
    --warn-bg:#fff6e0; --warn:#8a5a00; --err-bg:#fde8e8; --err:#9b1c1c;
  }
  body { font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Arial, sans-serif; margin: 20px; color: var(--text); background:#fff; }
  h1 { color: var(--blue-dark); margin-bottom: 6px; }
  h2 { margin: 24px 0 10px; color: var(--blue-dark); }
  em { color: var(--muted); }
  .highlight { border: 2px solid var(--blue); background: var(--blue-soft); padding: 16px; margin: 18px 0; border-radius: 10px; }
  .highlight strong { color: #000; }
  .highlight .city { color: #c40000; font-weight: 800; }
  .empty { color: var(--muted); font-style: italic; }
  .partial { color: var(--warn); background: var(--warn-bg); padding: 6px 10px; border-radius: 6px; }
  .meta-line { margin: 4px 0; line-height: 1.25; }
  .meta-line strong { color: var(--blue-dark); }
  .info-blue { color: var(--blue-dark); margin: 4px 0; }
  .banner { padding: 10px 14px; border-radius: 8px; margin: 10px 0; }
  .banner.alert { background:#ffe9d6; border:2px solid #e46b00; color:#7a3300; font-weight:700; }
  .banner.warn { background: var(--warn-bg); color: var(--warn); }
  .banner.err { background: var(--err-bg); color: var(--err); }
  .links-inline { display:flex; flex-wrap:wrap; align-items:baseline; gap:14px; margin: 10px 0 8px; }
  .links-inline .title { color: var(--blue-dark); font-weight:700; font-size:1.5rem; }
  .links-inline a { color: var(--blue-dark); font-weight:700; text-decoration: underline; }
  .table-wrap { overflow-x: auto; -webkit-overflow-scrolling: touch; margin-top: 10px; border: 1px solid var(--border); border-radius: 8px; }
  table { width: 100%; border-collapse: collapse; }
  th, td { white-space: nowrap; }
  /* 1re colonne (tranche horaire) figée pendant le défilement horizontal */
  th:first-child, td:first-child { position: sticky; left: 0; z-index: 1; background: #f8fbff; box-shadow: 1px 0 0 var(--border); }
  .highlight td:first-child { background: #eef4ff; }
  thead th { text-align: left; padding: 10px 12px; font-weight: 700; border-bottom: 2px solid var(--border); background: #f8fbff; }
  tbody td { padding: 12px; border-bottom: 1px solid var(--border); text-align: left; }
  tbody tr:hover { background: #fafcff; }
  .scroll-hint { display: none; font-size: .8rem; color: var(--muted); margin: 6px 0 0; }
  @media (max-width: 820px) {
    body { margin: 12px; }
    .highlight { padding: 10px; }
    thead th, tbody td { padding: 8px 10px; font-size: .9rem; }
    .scroll-hint { display: block; }
  }
  .kp4 { color: orange; font-weight: 700; }
  .kp5 { color: #d43d00; font-weight: 800; }
  .day { color: var(--muted); }
  footer { margin-top: 30px; font-size: .85rem; color: var(--muted); }
</style>
</head>
<body>
{%- macro kpcell(v) -%}
  {%- if v is none -%}—{%- elif v >= 5 -%}<span class="kp5">{{ v|kp }}</span>{%- elif v >= 4 -%}<span class="kp4">{{ v|kp }}</span>{%- else -%}{{ v|kp }}{%- endif -%}
{%- endmacro -%}
{%- macro clouds(s) -%}
  {%- if s.clouds_min is none -%}—{%- else -%}{{ "%.0f"|format(s.clouds_min) }}% - {{ "%.0f"|format(s.clouds_max) }}%{%- endif -%}
  {%- if not s.dark %} <span class="day">(jour)</span>{% endif -%}
{%- endmacro -%}
{%- macro moon(slot) -%}
  {{ "%.0f"|format(slot.illum) }}% ·
  {% for key, s in slot.sites.items() -%}
    {{ sites[key].name[0] }} {% if s.moon_alt > 0 %}↑{{ "%.0f"|format(s.moon_alt) }}°{% else %}↓{% endif %}{% if not loop.last %} / {% endif %}
  {%- endfor %}
{%- endmacro -%}
{%- macro table(night, with_scores=false) -%}
  <p class="scroll-hint">↔ faire défiler le tableau horizontalement</p>
  <div class="table-wrap"><table>
    <thead><tr>
      <th>Tranche (UTC)</th><th>NOAA Kp</th><th>GFZ median</th><th>GFZ q25</th><th>GFZ q75</th><th>GFZ min</th><th>GFZ max</th>
      <th>Nuages Tromsø</th><th>Nuages Grindavík</th><th>Lune</th>
      {%- if with_scores %}<th>Score Tromsø</th><th>Score Grindavík</th>{% endif %}
    </tr></thead>
    <tbody>
    {%- for s in night.slots %}
      <tr>
        <td data-label="Tranche (UTC)">{{ s.label }}</td>
        <td data-label="NOAA Kp">{{ kpcell(s.kp) }}</td>
        <td data-label="GFZ median">{{ s.gfz.median|num if s.gfz else "—" }}</td>
        <td data-label="GFZ q25">{{ s.gfz.q25|num if s.gfz else "—" }}</td>
        <td data-label="GFZ q75">{{ s.gfz.q75|num if s.gfz else "—" }}</td>
        <td data-label="GFZ min">{{ s.gfz.min|num if s.gfz else "—" }}</td>
        <td data-label="GFZ max">{{ s.gfz.max|num if s.gfz else "—" }}</td>
        <td data-label="Nuages Tromsø">{{ clouds(s.sites.tromso) }}</td>
        <td data-label="Nuages Grindavík">{{ clouds(s.sites.grindavik) }}</td>
        <td data-label="Lune">{{ moon(s) }}</td>
        {%- if with_scores %}
        <td data-label="Score Tromsø">{{ s.sites.tromso.score|pct }}</td>
        <td data-label="Score Grindavík">{{ s.sites.grindavik.score|pct }}</td>
        {%- endif %}
      </tr>
    {%- endfor %}
    </tbody>
  </table></div>
{%- endmacro -%}

<h1>Aurores — Destination pour le samedi {{ sat.date.isoformat() }}</h1>
<em>Généré le {{ now_paris }} - Heure de Paris ({{ now_utc }} UTC)</em><br>
<em>Pondération : KP {{ (weights.kp*100)|int }}% • Nuages {{ (weights.clouds*100)|int }}% • Lune {{ (weights.moon*100)|int }}%</em><br>
<em>Bulletin NOAA émis le {{ noaa_issued.strftime("%d/%m/%Y %H:%M") ~ " UTC" if noaa_issued else "—" }}</em>

{%- if alerts %}
<div class="banner alert">⚠ Kp NOAA ≥ {{ alert_kp|kp }} prévu :
  {% for a in alerts %}{{ a.start|jour }} {{ a.start.strftime("%d/%m %H") }}h UTC (Kp {{ a.kp|kp }}){% if not loop.last %}, {% endif %}{% endfor %}
</div>
{%- endif %}
{%- for w in warnings %}<div class="banner warn">{{ w }}</div>{% endfor %}
{%- for e in errors %}<div class="banner err">Source indisponible — {{ e }}</div>{% endfor %}

<div class="links-inline">
  <div class="title">Liens utiles :</div>
  <a href="https://www.swpc.noaa.gov/communities/aurora-dashboard-experimental" target="_blank" rel="noopener">NOAA Forecast</a>
  <a href="https://www.spaceweatherlive.com/en/auroral-activity/aurora-forecast.html" target="_blank" rel="noopener">Space Weather</a>
  <a href="https://www.yr.no/en/forecast/daily-table/1-305409/Norway/Troms/Troms%C3%B8/Troms%C3%B8" target="_blank" rel="noopener">Météo Tromsø</a>
  <a href="https://en.vedur.is/weather/forecasts/aurora/" target="_blank" rel="noopener">Météo Islande</a>
</div>

<div class="highlight">
{%- if reco %}
  <p><strong>Destination recommandée</strong> : <span class="city">{{ reco.name }}</span> — Score&nbsp;: {{ reco.score|pct }} — KP max nuit&nbsp;: {{ kpcell(sat.kp_max) }}
  {%- for key, sc in sat.site_scores.items() if key != reco.key %} <em>({{ sites[key].name }} : {{ sc|pct }})</em>{% endfor %}</p>
  {%- if sat.noaa_slots < sat.total_slots %}
  <p class="partial">⚠ Nuit partielle : {{ sat.noaa_slots }}/{{ sat.total_slots }} tranches couvertes par NOAA — score calculé sur ces tranches seulement (la nuit complète arrive avec le bulletin de la veille).</p>
  {%- endif %}
  <p><strong>Lune</strong> <em>(heure locale {{ reco.name }})</em> : lever {{ reco.moon.rise }}, coucher {{ reco.moon.set }}, illumination {{ "%.0f"|format(reco.illum) }}%</p>
  {{ table(sat, with_scores=true) }}
{%- else %}
  <p><strong>Destination recommandée</strong> : <span class="empty">pas encore de données NOAA pour la nuit du samedi {{ sat.date.isoformat() }} (le bulletin NOAA couvre J à J+2).</span></p>
{%- endif %}
</div>

<p class="info-blue">Décalages horaires actuels : {% for name, off in offsets.items() %}{{ name }} : {{ off }}{% if not loop.last %} ; {% endif %}{% endfor %}</p>
{%- for key, s in sites.items() %}
<p class="info-blue">{{ s.name }} ({{ "%.1f"|format(s.lat) }}°N) : {{ s.note }}</p>
{%- endfor %}
<p class="info-blue">Kp ≥ 6 : aurores quasi certaines sous ciel dégagé sur les deux sites.</p>

{%- for n in nights %}
<h2>{{ n.title }}</h2>
<p class="meta-line"><strong>NOAA Kp nuit :</strong> {{ kpcell(n.kp_max) }}</p>
<p class="meta-line"><strong>Meilleure fenêtre NOAA :</strong>
  {%- if n.best_window %} {{ n.best_window[0].strftime("%H") }}h (UTC) → {{ n.best_window[1].strftime("%H") }}h (UTC){% else %} —{% endif %}</p>
{{ table(n) }}
{%- endfor %}

<footer>
  Nuit = 15h UTC jour J → 09h UTC J+1. « (jour) » : soleil au-dessus de −6°, tranche exclue du score.
  Lune : illumination · T/G = levée (↑ hauteur) ou couchée (↓) à Tromsø / Grindavík.
  Sources : <a href="https://services.swpc.noaa.gov/text/3-day-forecast.txt">NOAA SWPC</a>,
  <a href="https://spaceweather.gfz.de/">GFZ</a>, <a href="https://open-meteo.com/">Open-Meteo</a>, lune calculée avec PyEphem.
</footer>
</body>
</html>
